-- CONFIG
local CORRECT_KEY = "B888" -- change this

-- SERVICES
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- GUI SETUP
local gui = Instance.new("ScreenGui")
gui.Name = "KeySystemGui"
gui.Parent = player:WaitForChild("PlayerGui")
gui.ResetOnSpawn = false

local frame = Instance.new("Frame")
frame.Parent = gui
frame.Size = UDim2.new(0, 300, 0, 180)
frame.Position = UDim2.new(0.5, -150, 0.5, -90)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.BorderSizePixel = 0

local corner = Instance.new("UICorner", frame)
corner.CornerRadius = UDim.new(0, 12)

local title = Instance.new("TextLabel")
title.Parent = frame
title.Size = UDim2.new(1, 0, 0, 40)
title.Text = "Enter Key"
title.TextColor3 = Color3.new(1,1,1)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBold
title.TextSize = 20

local box = Instance.new("TextBox")
box.Parent = frame
box.PlaceholderText = "Key here..."
box.Size = UDim2.new(0.85, 0, 0, 35)
box.Position = UDim2.new(0.075, 0, 0.35, 0)
box.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
box.TextColor3 = Color3.new(1,1,1)
box.Font = Enum.Font.Gotham
box.TextSize = 14
box.ClearTextOnFocus = false

Instance.new("UICorner", box)

local button = Instance.new("TextButton")
button.Parent = frame
button.Text = "Submit"
button.Size = UDim2.new(0.6, 0, 0, 35)
button.Position = UDim2.new(0.2, 0, 0.65, 0)
button.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
button.TextColor3 = Color3.new(1,1,1)
button.Font = Enum.Font.GothamBold
button.TextSize = 16

Instance.new("UICorner", button)

-- KEY CHECK
button.MouseButton1Click:Connect(function()
	if box.Text == CORRECT_KEY then
		gui:Destroy()
		print("Key accepted!")

		-- 🔓 PUT YOUR SCRIPT HERE
		-- Example:
		game.StarterGui:SetCore("SendNotification", {
			Title = "Success",
			Text = "Key accepted!",
			Duration = 3
		})

	else
		box.Text = ""
		box.PlaceholderText = "Wrong key!"
	end
end)
